# MarketRadar — variables de entorno
# Copia este archivo a `.env.local` y rellena los valores. Nunca commitees `.env.local`.
#
# Todas las variables son SERVER-ONLY: ninguna lleva prefijo NEXT_PUBLIC_, por lo que
# nunca llegan al bundle del navegador. La app solo accede a Supabase desde el servidor.

# Supabase local: valores que imprime `npx supabase status` tras `npm run db:start`.
SUPABASE_URL=http://127.0.0.1:54321
# Clave pública (anon / publishable). Las lecturas de la app pasan por RLS con esta clave.
SUPABASE_ANON_KEY=

# La caché de titulares traducidos se escribe desde el servidor web con esta clave.
# Nunca se expone al navegador; el resto de la app lee con la clave anon.
SUPABASE_SERVICE_ROLE_KEY=

# Traducción local de titulares (TranslateGemma 4B a través de Ollama, 0 €/mes).
# Instala Ollama, ejecuta `ollama pull translategemma:4b` y arranca `ollama serve`.
HEADLINE_TRANSLATION_PROVIDER=ollama
HEADLINE_TRANSLATION_URL=http://127.0.0.1:11434
# El identificador/version del modelo forma parte de la clave de caché.
HEADLINE_TRANSLATION_MODEL=translategemma:4b
# Alternativa local, más ligera pero con peor calidad para titulares financieros:
# docker compose -f compose.translation.yaml up -d
# HEADLINE_TRANSLATION_PROVIDER=libretranslate
# HEADLINE_TRANSLATION_URL=http://127.0.0.1:5000
# HEADLINE_TRANSLATION_VERSION=libretranslate-1.9.6-argos-model-1

# --- Jobs de sincronización (Fase 2B, CLI `npm run sync`) ---
# SEC EDGAR (gratuito, sin clave). La SEC pide un User-Agent con contacto: "Nombre contacto@dominio".
SEC_USER_AGENT=
# Alpaca Basic (gratuito, requiere cuenta; basta la de paper trading): precios diarios EE. UU. Secretos.
# También se aceptan los nombres ALPACA_API_KEY / ALPACA_SECRET_KEY.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# EODHD (OPCIONAL, de pago para uso real). Secreto: no lo compartas ni lo commitees.
EODHD_API_TOKEN=
# En local Supabase imprime la service_role key con `npx supabase status`.

# Fases futuras (no usadas todavía):
# OPENAI_API_KEY=
